      {
        "text": "Fine. Let's make one.",
        "voice_id": "s5t7B6IvxVOp3Y7HQT6Q"
      },
      {
        "text": "What is the goal?",
        "voice_id": "s2wvuS7SwITYg8dqsJdn"
      },
      {
        "text": "Produce a Future Radio episode.",
