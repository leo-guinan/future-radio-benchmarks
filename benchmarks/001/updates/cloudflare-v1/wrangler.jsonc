{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "future-radio",
  "account_id": "da0fccd48a7552c10afd10433b3d6f11",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/episode.mp3"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "future-radio-ledger",
      "database_id": "a8b25931-b759-4272-854c-49937de8e477",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
